{
  "manifest_version": 3,
  "name": "Selection ColorHighlight",
  "version": "${PACKAGE_VERSION}",
  "description": "${DESCRIPTION}",
  "content_scripts": [
    {
      "all_frames": true,
      "run_at": "document_end",
      "matches": ["<all_urls>"],
      "js": ["${CONTENT_SCRIPT_PATH}/main.js"]
    }
  ],
  "action": {
    "default_icon": "${IMAGES_PATH}/icon.png",
    "default_title": "Selection ColorHighlight"
  },
  "icons": {
    "1024": "${IMAGES_PATH}/icon.png"
  },
  "permissions": ["storage"]
}
